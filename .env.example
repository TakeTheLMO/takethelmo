# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 키(감사로그 기록, 계정 초대). 절대 NEXT_PUBLIC_ 를 붙이거나 브라우저 코드에서 import 하지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 인증 메일 링크의 기준 주소. 운영: https://실제도메인, 로컬: http://localhost:3000
# Supabase > Authentication > URL Configuration > Redirect URLs 에도 같은 주소의 /auth/callback 을 등록
NEXT_PUBLIC_SITE_URL=http://localhost:3000
