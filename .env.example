# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 새 대시보드의 Publishable key 를 쓰는 경우 위 대신 아래 이름도 인식한다
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 키(감사로그 기록, 계정 초대). 절대 NEXT_PUBLIC_ 를 붙이거나 브라우저 코드에서 import 하지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 인증 메일 링크의 기준 주소. 운영: https://실제도메인, 로컬: http://localhost:3000
# Supabase > Authentication > URL Configuration > Redirect URLs 에도 같은 주소의 /auth/callback 을 등록
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 포털 계정 저장소 (/portal, /login 등)
# 배포(Vercel 등 서버리스): Supabase Postgres 접속 문자열. 서버 전용 비밀값. NEXT_PUBLIC_ 금지.
#   Supabase > Connect > Transaction pooler (포트 6543) 주소를 쓴다.
# 미지정이면 로컬 SQLite(data/local-auth.sqlite)를 쓰며, Vercel 에서는 미지정 시 포털이 열리지 않는다.
# PORTAL_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 배포 DB 의 admin 계정 최초 비밀번호(12자 이상). 미지정이면 admin 계정을 만들지 않는다.
# PORTAL_ADMIN_PASSWORD=
# 로컬 SQLite 경로 (PORTAL_DATABASE_URL 이 없을 때만 사용)
# LOCAL_AUTH_DB_PATH=data/local-auth.sqlite
